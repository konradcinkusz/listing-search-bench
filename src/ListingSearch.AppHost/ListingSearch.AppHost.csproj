<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Aspire SDK version is pinned in global.json's msbuild-sdks block rather than
    here, so the AppHost SDK and the Aspire packages move together in one edit.
  -->
  <Sdk Name="Aspire.AppHost.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>listing-search-apphost</UserSecretsId>
    <!-- Never containerised: the AppHost is a development-time composition root (P1). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ListingSearch.SearchService/ListingSearch.SearchService.csproj" />
  </ItemGroup>

</Project>
