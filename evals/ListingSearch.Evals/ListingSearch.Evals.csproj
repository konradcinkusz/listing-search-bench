<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OutputType=Exe: xunit v3 runs as its own process (Microsoft.Testing.Platform,
    global.json). This is the poligon (evals/, README §2) — it never ships in a
    container and has no ProjectReference from src/.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ListingSearch.SearchService/ListingSearch.SearchService.csproj" />
  </ItemGroup>

  <ItemGroup Label="The corpus and fixtures, read directly from the repository at test time — not copied">
    <Content Include="../schema/*.json" LinkBase="EvalsData/schema" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../fixtures/*.yaml" LinkBase="EvalsData/fixtures" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../scenarios/**/*.yaml" LinkBase="EvalsData/scenarios" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../baselines/*.json" LinkBase="EvalsData/baselines" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../rubrics/*" LinkBase="EvalsData/rubrics" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../calibration/*.jsonl" LinkBase="EvalsData/calibration" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
