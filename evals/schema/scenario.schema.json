{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/konradcinkusz/listing-search-bench/evals/schema/scenario.schema.json",
  "title": "ListingSearch — scenario",
  "description": "One scenario in the Layer 1 corpus (docs/SPEC.md). Field-level semantics that depend on 'assert' (e.g. which of value/at_least/at_most a given assertion type reads) are enforced by AssertionEvaluator at run time, loudly — this schema enforces shape, not per-assert-type meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "class", "title", "why", "fixture", "steps", "expect"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(hap|amb|exc|adv|deg)-[0-9]{3}-[a-z0-9-]+$",
      "description": "Prefix must match class: hap=happy, amb=ambiguity, exc=exclusion, adv=adversarial, deg=degradation."
    },
    "class": {
      "type": "string",
      "enum": ["happy", "ambiguity", "exclusion", "adversarial", "degradation"]
    },
    "gate": {
      "type": "string",
      "enum": ["constraint", "behaviour"],
      "default": "behaviour"
    },
    "title": { "type": "string", "minLength": 8, "maxLength": 140 },
    "why": { "type": "string", "minLength": 20 },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["designed", "production-trace", "review", "incident"] },
        "date": { "type": "string", "format": "date" },
        "reference": { "type": "string" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base"],
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "pattern": "^lst-[0-9]{3,5}$" }
            },
            "additionalProperties": true
          }
        },
        "index_behaviour": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome"],
            "properties": {
              "outcome": {
                "type": "string",
                "enum": ["success", "timeout", "shard_unavailable", "malformed_embedding", "empty"]
              },
              "after_calls": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "action": { "type": "string", "enum": ["search", "ingest"] },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query"],
            "properties": {
              "query": { "type": "string" },
              "min_price": { "type": "number", "minimum": 0 },
              "max_price": { "type": "number", "minimum": 0 },
              "city": { "type": "string" },
              "min_rooms": { "type": "number", "minimum": 0 },
              "max_rooms": { "type": "number", "minimum": 0 },
              "soft_max_price": { "type": "number", "minimum": 0 },
              "sort": { "type": "string", "enum": ["relevance", "price_ascending", "price_descending"] },
              "top": { "type": "integer", "minimum": 1, "maximum": 50 }
            }
          },
          "event": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_id", "type", "listing_id"],
            "properties": {
              "event_id": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "enum": ["published", "price_changed", "delisted"] },
              "listing_id": { "type": "string", "pattern": "^lst-[0-9]{3,5}$" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "city": { "type": "string" },
              "price_chf": { "type": "number", "minimum": 0 },
              "rooms": { "type": "number", "minimum": 0 },
              "owner_id": { "type": "string", "pattern": "^own-[0-9]{2,4}$" }
            }
          }
        },
        "allOf": [
          { "if": { "properties": { "action": { "const": "search" } } }, "then": { "required": ["request"] } },
          { "if": { "properties": { "action": { "const": "ingest" } } }, "then": { "required": ["event"] } }
        ]
      }
    },
    "expect": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assert"],
        "properties": {
          "assert": {
            "type": "string",
            "enum": [
              "result_includes", "result_excludes",
              "candidate_set_includes", "candidate_set_excludes",
              "result_rank", "result_ranked_below", "result_attribution", "result_count",
              "outcome", "ingestion_outcome",
              "event_emitted", "event_not_emitted",
              "call_attempts", "response_excludes_internal_fields", "span_attribute"
            ]
          },
          "step": { "type": "integer", "minimum": 1 },
          "listing": { "type": "string" },
          "than": { "type": "string" },
          "path": { "type": "string", "enum": ["lexical", "vector", "any"] },
          "value": { "type": "string" },
          "times": { "type": "integer", "minimum": 0 },
          "at_least": { "type": "integer", "minimum": 0 },
          "at_most": { "type": "integer", "minimum": 0 },
          "event": { "type": "string" },
          "operation": { "type": "string", "enum": ["query", "vector_query", "index", "delete", "health"] },
          "max_attempts": { "type": "integer", "minimum": 1 },
          "attribute": { "type": "string" },
          "equals": { "type": "string" },
          "span": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stage": { "type": "string" },
              "event": { "type": "string" },
              "index_operation": { "type": "string" }
            }
          }
        }
      }
    },
    "rubrics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["relevance", "attribution-clarity", "exclusion-honesty", "degradation-honesty"]
      }
    },
    "skip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 20 },
        "since": { "type": "string", "format": "date" },
        "tracked_by": { "type": "string" }
      }
    }
  }
}
